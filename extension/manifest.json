{
  "manifest_version": 3,
  "name": "MMF Downloader",
  "version": "2.3.1",
  "description": "Archives your MyMiniFactory library into a folder you choose. Everything runs in Chrome: no other software needed.",
  "permissions": [
    "storage",
    "offscreen",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://www.myminifactory.com/*",
    "https://*.myminifactory.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open MMF Downloader"
  }
}
